{
  "name": "ISO 13567 (CI/SfB element codes)",
  "notes": [
    "Layer names use the ISO 13567-2 mandatory fields: agent (2), element (6), presentation (2).",
    "Element codes follow CI/SfB Table 1: 21 external walls, 22 internal walls, 3- secondary elements (doors, windows). Annotation layers have no element code.",
    "Presentation codes used: E element graphics, H hatching, T text, D dimensions.",
    "Where two layers would share the same mandatory fields, ISO 13567 fixed optional fields (positions 11-20) are left as '-' and a user-defined field from position 21 distinguishes them.",
    "Practices that use Uniclass or another classification should override 'layers' in an office profile ('extends': 'iso13567')."
  ],
  "sheet_number_pattern": "^[A-Z]{1,2}-\\d{3}$",
  "units": "mm",
