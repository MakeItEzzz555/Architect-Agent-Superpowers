{
  "name": "US National CAD Standard (AIA CAD Layer Guidelines), metric",
  "notes": [
    "Layer names use the NCS format: discipline designator - major group - minor group.",
    "Metric units and ISO paper sizes are used so drawings stay in millimetres; imperial units are not supported by this pipeline.",
    "Practices should override 'layers' in an office profile ('extends': 'ncs')."
  ],
  "sheet_number_pattern": "^[A-Z]{1,2}-?\\d{3}$",
